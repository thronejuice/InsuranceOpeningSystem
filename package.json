{
  "name": "insurance-opening-system",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run start -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "test": "npm run test -w apps/api && npm run test -w apps/web",
    "test:e2e": "npm run test:e2e -w apps/api",
    "lint": "npm run lint -w apps/api && npm run lint -w apps/web",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "db:reset": "npm run db:reset -w apps/api",
    "gen:api": "npm run gen:api -w apps/web",
    "e2e": "npm run e2e -w apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
