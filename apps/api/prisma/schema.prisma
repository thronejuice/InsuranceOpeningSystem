// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity & Access (spec §4, §35, DESIGN §8) ───────────────────────────

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  username     String    @unique
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  isActive     Boolean   @default(true) @map("is_active")
  branchId     String?   @map("branch_id") @db.Uuid
  managerId    String?   @map("manager_id") @db.Uuid
  agentSharePct Decimal? @map("agent_share_pct") @db.Decimal(5, 2)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById  String?   @map("created_by_id") @db.Uuid
  updatedById  String?   @map("updated_by_id") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  branch        Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  manager       User?     @relation("user_manager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates  User[]    @relation("user_manager")
  roles         UserRole[]
  refreshTokens RefreshToken[]
  activityLogs  ActivityLog[]
  agentJobs              Job[]              @relation("job_agent")
  assigneeJobs           Job[]              @relation("job_assignee")
  brokerStaffJobs        Job[]              @relation("job_broker_staff")
  fromJobAssignments    JobAssignmentHistory[] @relation("assignment_from_user")
  toJobAssignments      JobAssignmentHistory[] @relation("assignment_to_user")
  changedJobAssignments JobAssignmentHistory[] @relation("assignment_changed_by")
  changedStatusHistories JobStatusHistory[]
  uploadedDocuments      Document[]         @relation("document_uploader")
  verifiedDocuments      Document[]         @relation("document_verifier")
  requestedQuotations    Quotation[]        @relation("quotation_requester")
  createdProposals       Proposal[]         @relation("proposal_creator")
  requestedApprovals     Approval[]         @relation("approval_requester")
  approvedApprovals      Approval[]         @relation("approval_approver")
  resubmittedApprovals   Approval[]         @relation("approval_resubmitter")
  confirmedBindings      Binding[]          @relation("binding_confirmer")
  createdPolicies        Policy[]           @relation("policy_creator")
  createdPayments        Payment[]          @relation("payment_creator")
  agentCommissions       Commission[]       @relation("commission_agent")
  createdCommissions     Commission[]       @relation("commission_creator")
  assignedTasks          Task[]             @relation("task_assignee")
  createdTasks           Task[]             @relation("task_creator")
  completedTasks         Task[]             @relation("task_completer")
  assignedRenewals       Renewal[]          @relation("renewal_assignee")
  notifications          Notification[]     @relation("notification_user")
  notificationPreferences NotificationPreference[] @relation("notification_preferences")
  requestedUnderwritings Underwriting[]     @relation("underwriting_requester")
  reviewedUnderwritings  Underwriting[]     @relation("underwriting_reviewer")
  createdQuotationVersions QuotationVersion[] @relation("quotation_version_creator")
  recordedProposalAcceptances ProposalAcceptance[] @relation("proposal_acceptance_recorder")
  createdInvoices        Invoice[]          @relation("invoice_creator")
  cancelledInvoices      Invoice[]          @relation("invoice_canceller")
  voidedReceipts         Receipt[]          @relation("receipt_voider")
  approvedCommissions    Commission[]       @relation("commission_approver")
  updatedSettings        SystemSetting[]    @relation("system_setting_updater")
  commissionAdjustmentsOf CommissionAdjustment[] @relation("commission_adjustment_payee")
  createdCommissionAdjustments CommissionAdjustment[] @relation("commission_adjustment_creator")
  commissionStatementsOf CommissionStatement[] @relation("commission_statement_payee")
  createdCommissionStatements CommissionStatement[] @relation("commission_statement_creator")
  paidCommissionStatements CommissionStatement[] @relation("commission_statement_payer")
  createdReceipts        Receipt[]          @relation("receipt_creator")
  cancelledPolicies      Policy[]           @relation("policy_canceller")
  requestedEndorsements  Endorsement[]      @relation("endorsement_requester")
  reviewedEndorsements   Endorsement[]      @relation("endorsement_reviewer")
  approvedEndorsements   Endorsement[]      @relation("endorsement_approver")
  issuedEndorsements     Endorsement[]      @relation("endorsement_issuer")
  requestedRefunds       Refund[]           @relation("refund_requester")
  approvedRefunds        Refund[]           @relation("refund_approver")
  processedRefunds       Refund[]           @relation("refund_processor")

  @@index([branchId])
  @@index([managerId])
  @@map("users")
}

enum DataScope {
  OWN
  ASSIGNED
  TEAM
  BRANCH
  ALL

  @@map("data_scope")
}

model Role {
  id          String    @id @default(uuid(7)) @db.Uuid
  code        String    @unique
  name        String
  description String?
  dataScope   DataScope @default(OWN) @map("data_scope")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// DESIGN §5.1 — stores only the hash so a leaked DB cannot replay tokens
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum ActivitySource {
  WEB
  API
  JOB
  IMPORT

  @@map("activity_source")
}

model ActivityLog {
  id          String         @id @default(uuid(7)) @db.Uuid
  /// FK to jobs is added once the jobs table exists (Phase 2)
  jobId       String?        @map("job_id") @db.Uuid
  userId      String?        @map("user_id") @db.Uuid
  action      String
  entityType  String         @map("entity_type")
  entityId    String?        @map("entity_id")
  oldValue    Json?          @map("old_value")
  newValue    Json?          @map("new_value")
  source      ActivitySource @default(WEB)
  remark      String?
  description String?
  ipAddress   String?        @map("ip_address")
  userAgent   String?        @map("user_agent")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  job  Job?  @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ─── Customer (spec §7) ────────────────────────────────────────────────────

enum CustomerType {
  INDIVIDUAL
  CORPORATE

  @@map("customer_type")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE

  @@map("customer_status")
}

enum AddressType {
  HOME
  OFFICE
  BILLING
  SHIPPING
  OTHER

  @@map("address_type")
}

model Customer {
  id           String         @id @default(uuid(7)) @db.Uuid
  customerCode String         @unique @map("customer_code")
  customerType CustomerType   @map("customer_type")
  firstName    String?        @map("first_name")
  lastName     String?        @map("last_name")
  companyName  String?        @map("company_name")
  taxId        String?        @map("tax_id")
  citizenId    String?        @map("citizen_id")
  phone        String?
  mobile       String?
  email        String?
  status       CustomerStatus @default(ACTIVE)
  remark       String?
  createdById  String?        @map("created_by_id") @db.Uuid
  updatedById  String?        @map("updated_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(3)

  addresses  CustomerAddress[]
  contacts   CustomerContact[]
  jobs       Job[]
  proposals  Proposal[]
  invoices   Invoice[]
  tasks      Task[]

  @@index([customerType])
  @@index([status])
  @@index([email])
  @@index([taxId])
  @@map("customers")
}

model CustomerAddress {
  id          String      @id @default(uuid(7)) @db.Uuid
  customerId  String      @map("customer_id") @db.Uuid
  addressType AddressType @map("address_type")
  addressLine String      @map("address_line")
  subDistrict String?     @map("sub_district")
  district    String?
  province    String?
  postalCode  String?     @map("postal_code")
  country     String?     @default("Thailand")
  isPrimary   Boolean     @default(false) @map("is_primary")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerContact {
  id          String   @id @default(uuid(7)) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  contactName String   @map("contact_name")
  position    String?
  department  String?
  phone       String?
  mobile      String?
  email       String?
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_contacts")
}

// ─── Master Data (spec §8, §10, §11, §12.2, §16.2) ──────────────────────────

model Branch {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  name      String
  address   String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users     User[]
  jobs      Job[]

  @@map("branches")
}

model InsuranceType {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products      InsuranceProduct[]
  jobs          Job[]
  approvalRules ApprovalRule[]

  @@map("insurance_types")
}

model InsuranceProduct {
  id                  String   @id @default(uuid(7)) @db.Uuid
  insuranceTypeId     String   @map("insurance_type_id") @db.Uuid
  code                String   @unique
  name                String
  description         String?
  requireDocsOnSubmit Boolean  @default(false) @map("require_docs_on_submit")
  requireDocsOnBind   Boolean  @default(false) @map("require_docs_on_bind")
  requireUnderwriting Boolean  @default(false) @map("require_underwriting")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  insuranceType     InsuranceType         @relation(fields: [insuranceTypeId], references: [id])
  riskFields        RiskFieldDefinition[]
  coverages         InsuranceCoverage[]
  documentChecklist DocumentChecklist[]
  commissionRates   CommissionRate[]
  insurers          InsurerProduct[]
  jobs              Job[]
  approvalRules     ApprovalRule[]

  @@index([insuranceTypeId])
  @@map("insurance_products")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE

  @@map("company_status")
}

model InsuranceCompany {
  id          String        @id @default(uuid(7)) @db.Uuid
  code        String        @unique
  name        String
  taxId       String?       @map("tax_id")
  contactName String?       @map("contact_name")
  phone       String?
  email       String?
  address     String?
  bankAccount String?       @map("bank_account")
  status      CompanyStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(3)

  quotations      Quotation[]
  policies        Policy[]
  commissionRates CommissionRate[]
  bindings        Binding[]
  contacts        InsurerContact[]
  products        InsurerProduct[]

  @@index([status])
  @@map("insurance_companies")
}

/// A product an insurer accepts. The commission rate itself stays in commission_rates (effective-dated).
model InsurerProduct {
  id                 String           @id @default(uuid(7)) @db.Uuid
  insuranceCompanyId String           @map("insurance_company_id") @db.Uuid
  productId          String           @map("product_id") @db.Uuid
  remark             String?
  createdById        String?          @map("created_by_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?        @map("deleted_at") @db.Timestamptz(3)

  insuranceCompany InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id], onDelete: Restrict)
  product          InsuranceProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([insuranceCompanyId])
  @@index([productId])
  @@map("insurer_products")
}

model InsurerContact {
  id                 String           @id @default(uuid(7)) @db.Uuid
  insuranceCompanyId String           @map("insurance_company_id") @db.Uuid
  name               String
  position           String?
  email              String?
  phone              String?
  isUnderwriter      Boolean          @default(false) @map("is_underwriter")
  isPrimary          Boolean          @default(false) @map("is_primary")
  active             Boolean          @default(true)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?        @map("deleted_at") @db.Timestamptz(3)

  insuranceCompany InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id], onDelete: Cascade)

  @@index([insuranceCompanyId])
  @@index([isUnderwriter])
  @@map("insurer_contacts")
}

model InsuranceCoverage {
  id                String   @id @default(uuid(7)) @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  code              String
  name              String
  description       String?
  defaultSumInsured Decimal? @map("default_sum_insured") @db.Decimal(15, 2)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product        InsuranceProduct @relation(fields: [productId], references: [id])
  jobCoverages   JobCoverage[]
  quotationItems QuotationItem[]

  @@unique([productId, code])
  @@index([productId])
  @@map("insurance_coverages")
}

enum RiskFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
  FILE
  JSON

  @@map("risk_field_type")
}

model RiskFieldDefinition {
  id             String        @id @default(uuid(7)) @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  fieldCode      String        @map("field_code")
  fieldName      String        @map("field_name")
  fieldType      RiskFieldType @map("field_type")
  isRequired     Boolean       @default(false) @map("is_required")
  validationRule String?       @map("validation_rule")
  sortOrder      Int           @default(0) @map("sort_order")
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  product InsuranceProduct @relation(fields: [productId], references: [id])

  @@unique([productId, fieldCode])
  @@index([productId, sortOrder])
  @@map("risk_field_definitions")
}

enum DocumentType {
  ID_CARD
  COMPANY_REGISTRATION
  TAX_DOCUMENT
  VEHICLE_BOOK
  PREVIOUS_POLICY
  VEHICLE_PHOTO
  RISK_SURVEY
  QUOTATION
  PROPOSAL
  POLICY
  INVOICE
  RECEIPT
  OTHER

  @@map("document_type")
}

model DocumentChecklist {
  id           String       @id @default(uuid(7)) @db.Uuid
  productId    String       @map("product_id") @db.Uuid
  documentType DocumentType @map("document_type")
  isRequired   Boolean      @default(true) @map("is_required")
  sortOrder    Int          @default(0) @map("sort_order")
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  product InsuranceProduct @relation(fields: [productId], references: [id])

  @@unique([productId, documentType])
  @@index([productId])
  @@map("document_checklists")
}

// ─── Commission Rate Master (Phase 2 Day 11, D26, D42) ─────────────────────────

model CommissionRate {
  id                 String           @id @default(uuid(7)) @db.Uuid
  insuranceCompanyId String           @map("insurance_company_id") @db.Uuid
  productId          String           @map("product_id") @db.Uuid
  rate               Decimal          @db.Decimal(10, 4)
  effectiveFrom      DateTime         @map("effective_from") @db.Date
  effectiveTo        DateTime?        @map("effective_to") @db.Date
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?        @map("deleted_at") @db.Timestamptz(3)

  insuranceCompany   InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id])
  product            InsuranceProduct @relation(fields: [productId], references: [id])

  @@index([insuranceCompanyId])
  @@index([productId])
  @@index([effectiveFrom, effectiveTo])
  @@map("commission_rates")
}

// ─── Payment Term Master (Phase 2 Day 13 / OQ-2) ─────────────────────────────

model PaymentTerm {
  id             String     @id @default(uuid(7)) @db.Uuid
  code           String     @unique
  name           String
  description    String?
  installments   Int        @default(1)
  intervalMonths Int        @default(0) @map("interval_months")
  firstDueDays   Int        @default(30) @map("first_due_days")
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  proposals      Proposal[]

  @@map("payment_terms")
}

enum ApprovalConditionField {
  PREMIUM
  DISCOUNT
  SUM_INSURED

  @@map("approval_condition_field")
}

enum ApprovalConditionOperator {
  LT
  LTE
  GT
  GTE
  EQ

  @@map("approval_condition_operator")
}

enum ApprovalRoleTarget {
  SUPERVISOR
  MANAGER
  ADMIN

  @@map("approval_role_target")
}

enum ApprovalEntityType {
  JOB
  ENDORSEMENT

  @@map("approval_entity_type")
}

model ApprovalRule {
  id                String                    @id @default(uuid(7)) @db.Uuid
  name              String
  entityType        ApprovalEntityType        @default(JOB) @map("entity_type")
  productId         String?                   @map("product_id") @db.Uuid
  insuranceTypeId   String?                   @map("insurance_type_id") @db.Uuid
  riskLevel         String?                   @map("risk_level")
  conditionField    ApprovalConditionField    @map("condition_field")
  conditionOperator ApprovalConditionOperator @map("condition_operator")
  thresholdValue    Decimal                   @map("threshold_value") @db.Decimal(15, 2)
  approverRole      ApprovalRoleTarget        @map("approver_role")
  active            Boolean                   @default(true)
  sortOrder         Int                       @default(0) @map("sort_order")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  product           InsuranceProduct?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  insuranceType     InsuranceType?            @relation(fields: [insuranceTypeId], references: [id], onDelete: SetNull)

  @@index([entityType])
  @@index([productId])
  @@index([insuranceTypeId])
  @@map("approval_rules")
}

// ─── Company profile (letterhead for customer-facing documents) ─────────────

/// Singleton row (id = "default") — broker/agent letterhead printed on the proposal PDF.
model CompanyProfile {
  id              String   @id @default("default")
  nameTh          String   @map("name_th")
  nameEn          String?  @map("name_en")
  addressTh       String?  @map("address_th")
  addressEn       String?  @map("address_en")
  taxId           String?  @map("tax_id")
  brokerLicenseNo String?  @map("broker_license_no")
  phone           String?
  email           String?
  website         String?
  /// Storage path of the uploaded logo (PNG/JPG)
  logoPath        String?  @map("logo_path")
  logoMimeType    String?  @map("logo_mime_type")
  /// Standard terms printed on the proposal, one per line
  proposalTerms   String?  @map("proposal_terms")
  /// [{ bankName, branch, accountName, accountNo }]
  bankAccounts    Json     @default("[]") @map("bank_accounts")
  updatedById     String?  @map("updated_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("company_profile")
}

// ─── Running number (DESIGN §5.2) ──────────────────────────────────────────

model DocumentSequence {
  prefix    String
  /// 0 = sequence that does not reset yearly (e.g. CUS)
  year      Int
  lastValue Int      @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([prefix, year])
  @@map("document_sequences")
}

// ─── Job (spec §9, §6, DESIGN §7) ────────────────────────────────────────────

enum JobStatus {
  DRAFT
  OPEN
  WAITING_INFORMATION
  QUOTATION_REQUESTED
  QUOTATION_RECEIVED
  QUOTATION_SELECTED
  PROPOSAL_SENT
  WAITING_CUSTOMER
  CUSTOMER_ACCEPTED
  CUSTOMER_REJECTED
  WAITING_APPROVAL
  APPROVAL_REJECTED
  APPROVED
  BINDING
  POLICY_PENDING
  POLICY_ISSUED
  CANCELLED
  CLOSED
  EXPIRED
  RENEWAL

  @@map("job_status")
}

enum JobPriority {
  NORMAL
  HIGH
  URGENT

  @@map("job_priority")
}

model Job {
  id                  String      @id @default(uuid(7)) @db.Uuid
  jobNo               String      @unique @map("job_no")
  customerId          String      @map("customer_id") @db.Uuid
  insuranceTypeId     String      @map("insurance_type_id") @db.Uuid
  productId           String      @map("product_id") @db.Uuid
  agentId             String      @map("agent_id") @db.Uuid
  assignedTo          String?     @map("assigned_to") @db.Uuid
  brokerStaffId       String?     @map("broker_staff_id") @db.Uuid
  branchId            String?     @map("branch_id") @db.Uuid
  source              String?
  priority            JobPriority @default(NORMAL)
  status              JobStatus   @default(DRAFT)
  effectiveDate       DateTime    @map("effective_date") @db.Date
  expiryDate          DateTime?   @map("expiry_date") @db.Date
  remark              String?
  version             Int         @default(1)
  selectedQuotationId String?     @unique @map("selected_quotation_id") @db.Uuid
  previousPolicyId    String?     @map("previous_policy_id") @db.Uuid
  createdById         String?     @map("created_by_id") @db.Uuid
  updatedById         String?     @map("updated_by_id") @db.Uuid
  deletedAt           DateTime?   @map("deleted_at") @db.Timestamptz(3)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Cancel request (D-26)
  cancelRequestedAt   DateTime?   @map("cancel_requested_at") @db.Timestamptz(3)
  cancelRequestedById String?     @map("cancel_requested_by_id") @db.Uuid
  cancelRequestReason String?     @map("cancel_request_reason")
  cancellationReason  String?     @map("cancellation_reason")
  cancelledAt         DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  cancelledById       String?     @map("cancelled_by_id") @db.Uuid

  customer            Customer               @relation(fields: [customerId], references: [id])
  insuranceType       InsuranceType          @relation(fields: [insuranceTypeId], references: [id])
  product             InsuranceProduct       @relation(fields: [productId], references: [id])
  agent               User                   @relation("job_agent", fields: [agentId], references: [id])
  assignee            User?                  @relation("job_assignee", fields: [assignedTo], references: [id])
  brokerStaff         User?                  @relation("job_broker_staff", fields: [brokerStaffId], references: [id])
  branch              Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  statusHistories     JobStatusHistory[]
  assignmentHistories JobAssignmentHistory[]
  activityLogs        ActivityLog[]
  risk                JobRisk?
  coverages           JobCoverage[]
  documents           Document[]
  quotations          Quotation[]            @relation("job_quotations")
  selectedQuotation   Quotation?             @relation("job_selected_quotation", fields: [selectedQuotationId], references: [id])
  proposals           Proposal[]
  approvals           Approval[]
  binding             Binding?
  policy              Policy?
  tasks               Task[]
  renewalAsNew        Renewal?               @relation("renewal_new_job")
  underwritings       Underwriting[]

  @@index([customerId])
  @@index([agentId])
  @@index([brokerStaffId])
  @@index([branchId])
  @@index([status])
  @@index([productId])
  @@index([effectiveDate])
  @@index([deletedAt])
  @@map("jobs")
}

enum AssignmentRole {
  AGENT
  BROKER_STAFF
  MANAGER

  @@map("assignment_role")
}

model JobAssignmentHistory {
  id          String         @id @default(uuid(7)) @db.Uuid
  jobId       String         @map("job_id") @db.Uuid
  role        AssignmentRole
  fromUserId  String?        @map("from_user_id") @db.Uuid
  toUserId    String?        @map("to_user_id") @db.Uuid
  reason      String?
  changedById String?        @map("changed_by_id") @db.Uuid
  changedAt   DateTime       @default(now()) @map("changed_at") @db.Timestamptz(3)

  job       Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromUser  User? @relation("assignment_from_user", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser    User? @relation("assignment_to_user", fields: [toUserId], references: [id], onDelete: SetNull)
  changedBy User? @relation("assignment_changed_by", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([role])
  @@map("job_assignment_histories")
}

model JobStatusHistory {
  id          String    @id @default(uuid(7)) @db.Uuid
  jobId       String    @map("job_id") @db.Uuid
  fromStatus  JobStatus @map("from_status")
  toStatus    JobStatus @map("to_status")
  reason      String?
  changedById String?   @map("changed_by_id") @db.Uuid
  changedAt   DateTime  @default(now()) @map("changed_at") @db.Timestamptz(3)

  job       Job   @relation(fields: [jobId], references: [id])
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@map("job_status_histories")
}

// ─── Job Risk (spec §10) ──────────────────────────────────────────────────────

model JobRisk {
  id        String   @id @default(uuid(7)) @db.Uuid
  jobId     String   @unique @map("job_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  job    Job            @relation(fields: [jobId], references: [id])
  values JobRiskValue[]

  @@map("job_risks")
}

model JobRiskValue {
  id         String   @id @default(uuid(7)) @db.Uuid
  jobRiskId  String   @map("job_risk_id") @db.Uuid
  fieldCode  String   @map("field_code")
  fieldValue String?  @map("field_value")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  jobRisk JobRisk @relation(fields: [jobRiskId], references: [id], onDelete: Cascade)

  @@unique([jobRiskId, fieldCode])
  @@index([jobRiskId])
  @@map("job_risk_values")
}

model JobCoverage {
  id         String   @id @default(uuid(7)) @db.Uuid
  jobId      String   @map("job_id") @db.Uuid
  coverageId String   @map("coverage_id") @db.Uuid
  sumInsured Decimal? @map("sum_insured") @db.Decimal(15, 2)
  deductible Decimal? @db.Decimal(15, 2)
  remark     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  job      Job               @relation(fields: [jobId], references: [id])
  coverage InsuranceCoverage @relation(fields: [coverageId], references: [id])

  @@unique([jobId, coverageId])
  @@index([jobId])
  @@map("job_coverages")
}

// ─── Documents (spec §36) ─────────────────────────────────────────────────────

enum DocumentStatus {
  REQUIRED
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED

  @@map("document_status")
}

model Document {
  id           String         @id @default(uuid(7)) @db.Uuid
  jobId        String         @map("job_id") @db.Uuid
  documentType DocumentType   @map("document_type")
  originalName String         @map("original_name")
  storedName   String         @map("stored_name")
  mimeType     String         @map("mime_type")
  size         Int
  storagePath  String         @map("storage_path")
  version      Int            @default(1)
  status       DocumentStatus @default(UPLOADED)
  uploadedById String?        @map("uploaded_by_id") @db.Uuid
  verifiedById String?        @map("verified_by_id") @db.Uuid
  verifiedAt   DateTime?      @map("verified_at") @db.Timestamptz(3)
  expiryDate   DateTime?      @map("expiry_date") @db.Date
  remark       String?
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  job        Job   @relation(fields: [jobId], references: [id])
  uploadedBy User? @relation("document_uploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  verifiedBy User? @relation("document_verifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  proposalAcceptances ProposalAcceptance[]
  binderDocuments     Binding[]
  policyDocuments     Policy[]            @relation("policy_document")
  policyCancelDocuments Policy[]          @relation("policy_cancel_document")
  endorsementDocuments Endorsement[]      @relation("endorsement_document")
  refundAttachments   Refund[]            @relation("refund_attachment")
  paymentAttachments  Payment[]           @relation("payment_attachment")

  @@index([jobId, status])
  @@index([jobId, documentType])
  @@index([expiryDate])
  @@map("documents")
}

// ─── Underwriting (Phase 1 Day 8) ─────────────────────────────────────────────

enum UnderwritingStatus {
  PENDING
  INFO_REQUIRED
  APPROVED
  REJECTED

  @@map("underwriting_status")
}

model Underwriting {
  id                String             @id @default(uuid(7)) @db.Uuid
  jobId             String             @map("job_id") @db.Uuid
  version           Int                @default(1)
  status            UnderwritingStatus @default(PENDING)
  riskLevel         String?            @map("risk_level")
  riskScore         Float?             @map("risk_score")
  requestedById     String?            @map("requested_by_id") @db.Uuid
  requestedAt       DateTime           @default(now()) @map("requested_at") @db.Timestamptz(3)
  underwriterId     String?            @map("underwriter_id") @db.Uuid
  reviewedAt        DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  reason            String?
  condition         String?
  exclusion         String?
  deductible        Decimal?           @db.Decimal(15, 2)
  requiredSurvey    Boolean            @default(false) @map("required_survey")
  requiredDocuments Json?              @map("required_documents")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(3)

  job               Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  requestedBy       User?              @relation("underwriting_requester", fields: [requestedById], references: [id])
  underwriter       User?              @relation("underwriting_reviewer", fields: [underwriterId], references: [id])

  @@unique([jobId, version])
  @@index([jobId])
  @@index([status])
  @@index([underwriterId])
  @@map("underwritings")
}

// ─── Quotation (spec §13, §14, DESIGN Q5, Phase 2 Day 11) ──────────────────────

enum QuotationStatus {
  REQUESTED
  RECEIVED
  SELECTED
  REJECTED
  EXPIRED
  WITHDRAWN
  CANCELLED

  @@map("quotation_status")
}

enum QuotationVersionStatus {
  ACTIVE
  SUPERSEDED
  SELECTED
  REJECTED
  WITHDRAWN
  EXPIRED

  @@map("quotation_version_status")
}

model Quotation {
  id                 String          @id @default(uuid(7)) @db.Uuid
  jobId              String          @map("job_id") @db.Uuid
  insuranceCompanyId String          @map("insurance_company_id") @db.Uuid
  quotationNo        String          @unique @map("quotation_no")
  quotationDate      DateTime?       @map("quotation_date") @db.Date
  validUntil         DateTime?       @map("valid_until") @db.Date
  status             QuotationStatus @default(REQUESTED)
  grossPremium       Decimal         @default(0) @map("gross_premium") @db.Decimal(15, 2)
  discount           Decimal         @default(0) @db.Decimal(15, 2)
  netPremium         Decimal         @default(0) @map("net_premium") @db.Decimal(15, 2)
  tax                Decimal         @default(0) @db.Decimal(15, 2)
  stampDuty          Decimal         @default(0) @map("stamp_duty") @db.Decimal(15, 2)
  totalAmount        Decimal         @default(0) @map("total_amount") @db.Decimal(15, 2)
  remark             String?
  version            Int             @default(1)
  requestedById      String?         @map("requested_by_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz(3)

  job              Job                @relation("job_quotations", fields: [jobId], references: [id])
  insuranceCompany InsuranceCompany   @relation(fields: [insuranceCompanyId], references: [id])
  requestedBy      User?              @relation("quotation_requester", fields: [requestedById], references: [id], onDelete: SetNull)
  items            QuotationItem[]
  versions         QuotationVersion[]
  selectedByJob    Job?               @relation("job_selected_quotation")
  proposals        Proposal[]
  bindings         Binding[]
  policies         Policy[]

  @@index([jobId])
  @@index([status])
  @@map("quotations")
}

model QuotationVersion {
  id               String                 @id @default(uuid(7)) @db.Uuid
  quotationId      String                 @map("quotation_id") @db.Uuid
  version          Int                    @default(1)
  status           QuotationVersionStatus @default(ACTIVE)
  quotationDate    DateTime?              @map("quotation_date") @db.Date
  validUntil       DateTime?              @map("valid_until") @db.Date
  grossPremium     Decimal                @default(0) @map("gross_premium") @db.Decimal(15, 2)
  discount         Decimal                @default(0) @db.Decimal(15, 2)
  netPremium       Decimal                @default(0) @map("net_premium") @db.Decimal(15, 2)
  tax              Decimal                @default(0) @db.Decimal(15, 2)
  stampDuty        Decimal                @default(0) @map("stamp_duty") @db.Decimal(15, 2)
  totalAmount      Decimal                @default(0) @map("total_amount") @db.Decimal(15, 2)
  commissionRate   Decimal?               @map("commission_rate") @db.Decimal(10, 4)
  commissionAmount Decimal?               @map("commission_amount") @db.Decimal(15, 2)
  deductible       Decimal?               @db.Decimal(15, 2)
  exclusion        String?                @db.Text
  specialCondition String?                @map("special_condition") @db.Text
  insurerReference String?                @map("insurer_reference")
  underwriter      String?
  attachment       String?
  remark           String?                @db.Text
  createdById      String?                @map("created_by_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?              @map("deleted_at") @db.Timestamptz(3)

  quotation        Quotation              @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  createdBy        User?                  @relation("quotation_version_creator", fields: [createdById], references: [id], onDelete: SetNull)
  items            QuotationItem[]
  proposals        Proposal[]

  @@unique([quotationId, version])
  @@index([quotationId])
  @@index([status])
  @@index([validUntil])
  @@map("quotation_versions")
}

model QuotationItem {
  id                 String            @id @default(uuid(7)) @db.Uuid
  quotationId        String            @map("quotation_id") @db.Uuid
  quotationVersionId String?           @map("quotation_version_id") @db.Uuid
  coverageId         String?           @map("coverage_id") @db.Uuid
  coverageName       String            @map("coverage_name")
  sumInsured         Decimal           @map("sum_insured") @db.Decimal(15, 2)
  rate               Decimal?          @db.Decimal(10, 6)
  deductible         Decimal?          @db.Decimal(15, 2)
  premium            Decimal           @db.Decimal(15, 2)
  remark             String?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  quotation        Quotation          @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationVersion QuotationVersion?  @relation(fields: [quotationVersionId], references: [id], onDelete: Cascade)
  coverage         InsuranceCoverage? @relation(fields: [coverageId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([quotationVersionId])
  @@map("quotation_items")
}

// ─── Proposal (spec §15, DESIGN §29.7) ───────────────────────────────────────

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED

  @@map("proposal_status")
}

enum ProposalRejectReason {
  PRICE
  COVERAGE
  COMPETITOR
  CUSTOMER_CANCELLED
  NO_RESPONSE
  OTHER

  @@map("proposal_reject_reason")
}

model Proposal {
  id                 String                @id @default(uuid(7)) @db.Uuid
  proposalNo         String                @unique @map("proposal_no")
  jobId              String                @map("job_id") @db.Uuid
  quotationId        String                @map("quotation_id") @db.Uuid
  quotationVersionId String?               @map("quotation_version_id") @db.Uuid
  paymentTermId      String?               @map("payment_term_id") @db.Uuid
  customerId         String                @map("customer_id") @db.Uuid
  proposalDate       DateTime?             @map("proposal_date") @db.Date
  validUntil         DateTime?             @map("valid_until") @db.Date
  status             ProposalStatus        @default(DRAFT)
  sentAt             DateTime?             @map("sent_at") @db.Timestamptz(3)
  acceptedAt         DateTime?             @map("accepted_at") @db.Timestamptz(3)
  rejectedAt         DateTime?             @map("rejected_at") @db.Timestamptz(3)
  rejectReason       ProposalRejectReason? @map("reject_reason")
  coverageSummary    String?               @map("coverage_summary") @db.Text
  terms              String?               @db.Text
  conditions         String?               @db.Text
  remark             String?
  version            Int                   @default(1)
  createdById        String?               @map("created_by_id") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  job              Job               @relation(fields: [jobId], references: [id])
  quotation        Quotation         @relation(fields: [quotationId], references: [id])
  quotationVersion QuotationVersion? @relation(fields: [quotationVersionId], references: [id], onDelete: SetNull)
  paymentTerm      PaymentTerm?      @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  customer         Customer          @relation(fields: [customerId], references: [id])
  createdBy        User?             @relation("proposal_creator", fields: [createdById], references: [id], onDelete: SetNull)
  approvals        Approval[]
  acceptances      ProposalAcceptance[]

  @@index([jobId])
  @@index([status])
  @@index([paymentTermId])
  @@map("proposals")
}

// ─── Acceptance Evidence (Phase 2 Day 14) ───────────────────────────────────

enum AcceptanceMethod {
  EMAIL
  SIGNED_DOCUMENT
  LINE
  MANUAL

  @@map("acceptance_method")
}

model ProposalAcceptance {
  id              String           @id @default(uuid(7)) @db.Uuid
  proposalId      String           @map("proposal_id") @db.Uuid
  proposalVersion Int              @map("proposal_version")
  acceptedByName  String           @map("accepted_by_name")
  acceptedAt      DateTime         @default(now()) @map("accepted_at") @db.Timestamptz(3)
  method          AcceptanceMethod @map("method")
  ipAddress       String?          @map("ip_address")
  evidenceFileId  String?          @map("evidence_file_id") @db.Uuid
  remark          String?
  recordedById    String?          @map("recorded_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  proposal     Proposal  @relation(fields: [proposalId], references: [id])
  evidenceFile Document? @relation(fields: [evidenceFileId], references: [id], onDelete: SetNull)
  recordedBy   User?     @relation("proposal_acceptance_recorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([proposalId])
  @@index([evidenceFileId])
  @@index([recordedById])
  @@map("proposal_acceptances")
}

// ─── Approval (spec §16) ─────────────────────────────────────────────────────

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("approval_status")
}

model Approval {
  id            String             @id @default(uuid(7)) @db.Uuid
  jobId         String             @map("job_id") @db.Uuid
  proposalId    String             @map("proposal_id") @db.Uuid
  approvalType  ApprovalRoleTarget @map("approval_type")
  requestedById String?            @map("requested_by_id") @db.Uuid
  approverId    String?            @map("approver_id") @db.Uuid
  status        ApprovalStatus     @default(PENDING)
  requestedAt   DateTime           @default(now()) @map("requested_at") @db.Timestamptz(3)
  approvedAt    DateTime?          @map("approved_at") @db.Timestamptz(3)
  rejectedAt    DateTime?          @map("rejected_at") @db.Timestamptz(3)
  reason          String?
  rejectReason    String?            @map("reject_reason")
  comment         String?
  remark          String?
  resubmittedAt   DateTime?          @map("resubmitted_at") @db.Timestamptz(3)
  resubmittedById String?            @map("resubmitted_by_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  job           Job      @relation(fields: [jobId], references: [id])
  proposal      Proposal @relation(fields: [proposalId], references: [id])
  requestedBy   User?    @relation("approval_requester", fields: [requestedById], references: [id], onDelete: SetNull)
  approver      User?    @relation("approval_approver", fields: [approverId], references: [id], onDelete: SetNull)
  resubmittedBy User?    @relation("approval_resubmitter", fields: [resubmittedById], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([status])
  @@map("approvals")
}

// ─── Idempotency (DESIGN §5.1) ───────────────────────────────────────────────

model IdempotencyKey {
  key        String   @id
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@map("idempotency_keys")
}

// ─── Binding (spec §17) ──────────────────────────────────────────────────────

enum BindingStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  REJECTED
  CANCELLED

  @@map("binding_status")
}

model Binding {
  id               String        @id @default(uuid(7)) @db.Uuid
  jobId            String        @unique @map("job_id") @db.Uuid
  quotationId      String        @map("quotation_id") @db.Uuid
  status           BindingStatus @default(SUBMITTED)
  bindingDate      DateTime      @map("binding_date") @db.Date
  effectiveDate    DateTime      @map("effective_date") @db.Date
  expiryDate       DateTime?     @map("expiry_date") @db.Date
  binderNumber     String?       @map("binder_number")
  binderDate       DateTime?     @map("binder_date") @db.Date
  insurerId        String?       @map("insurer_id") @db.Uuid
  premium          Decimal?      @map("premium") @db.Decimal(15, 2)
  paymentCondition String?       @map("payment_condition")
  underwriter      String?
  binderDocumentId String?       @map("binder_document_id") @db.Uuid
  confirmedById    String?       @map("confirmed_by_id") @db.Uuid
  remark           String?
  rejectionReason  String?       @map("rejection_reason")
  cancelledAt      DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledById    String?       @map("cancelled_by_id") @db.Uuid
  idempotencyKey   String?       @unique @map("idempotency_key")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  job            Job               @relation(fields: [jobId], references: [id])
  quotation      Quotation         @relation(fields: [quotationId], references: [id])
  insurer        InsuranceCompany? @relation(fields: [insurerId], references: [id], onDelete: SetNull)
  binderDocument Document?         @relation(fields: [binderDocumentId], references: [id], onDelete: SetNull)
  confirmedBy    User?             @relation("binding_confirmer", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([insurerId])
  @@index([status])
  @@map("bindings")
}

// ─── Policy (spec §18) ───────────────────────────────────────────────────────

enum PolicyStatus {
  DRAFT
  PENDING
  ISSUED
  ACTIVE
  EXPIRING
  EXPIRED
  CANCEL_REQUESTED
  CANCELLED
  RENEWED

  @@map("policy_status")
}

model Policy {
  id                 String       @id @default(uuid(7)) @db.Uuid
  policyNo           String       @unique @map("policy_no")
  jobId              String       @unique @map("job_id") @db.Uuid
  quotationId        String       @map("quotation_id") @db.Uuid
  insuranceCompanyId String       @map("insurance_company_id") @db.Uuid
  policyType         String?      @map("policy_type")
  effectiveDate      DateTime     @map("effective_date") @db.Date
  expiryDate         DateTime?    @map("expiry_date") @db.Date
  sumInsured         Decimal?     @map("sum_insured") @db.Decimal(15, 2)
  deductible         Decimal?     @map("deductible") @db.Decimal(15, 2)
  policyDocumentId   String?      @map("policy_document_id") @db.Uuid
  grossPremium       Decimal      @default(0) @map("gross_premium") @db.Decimal(15, 2)
  discount           Decimal      @default(0) @db.Decimal(15, 2)
  netPremium         Decimal      @default(0) @map("net_premium") @db.Decimal(15, 2)
  tax                Decimal      @default(0) @db.Decimal(15, 2)
  stampDuty          Decimal      @default(0) @map("stamp_duty") @db.Decimal(15, 2)
  totalPremium       Decimal      @default(0) @map("total_premium") @db.Decimal(15, 2)
  status             PolicyStatus @default(PENDING)
  paymentDueDate     DateTime?    @map("payment_due_date") @db.Date
  issuedAt           DateTime?    @map("issued_at") @db.Timestamptz(3)
  remark             String?
  version            Int          @default(1)
  cancelReason       String?      @map("cancel_reason")
  cancelRequestDate  DateTime?    @map("cancel_request_date") @db.Date
  cancelEffectiveDate DateTime?   @map("cancel_effective_date") @db.Date
  cancelInsurerDocumentId String? @map("cancel_insurer_document_id") @db.Uuid
  cancelRequestedById String?     @map("cancel_requested_by_id") @db.Uuid
  cancelRefundAmount Decimal?     @map("cancel_refund_amount") @db.Decimal(15, 2)
  cancelOutstandingAmount Decimal? @map("cancel_outstanding_amount") @db.Decimal(15, 2)
  cancelledAt        DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  cancelledById      String?      @map("cancelled_by_id") @db.Uuid
  createdById        String?      @map("created_by_id") @db.Uuid
  updatedById        String?      @map("updated_by_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  job                   Job              @relation(fields: [jobId], references: [id])
  quotation             Quotation        @relation(fields: [quotationId], references: [id])
  insuranceCompany      InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id])
  policyDocument        Document?        @relation("policy_document", fields: [policyDocumentId], references: [id], onDelete: SetNull)
  cancelInsurerDocument Document?        @relation("policy_cancel_document", fields: [cancelInsurerDocumentId], references: [id], onDelete: SetNull)
  createdBy             User?            @relation("policy_creator", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy           User?            @relation("policy_canceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  coverages             PolicyCoverage[]
  payments              Payment[]
  commissions           Commission[]
  invoices              Invoice[]
  renewals              Renewal[]        @relation("renewal_previous_policy")
  endorsements          Endorsement[]
  versions              PolicyVersion[]
  tasks                 Task[]

  @@index([status])
  @@index([policyDocumentId])
  @@map("policies")
}

model PolicyCoverage {
  id           String   @id @default(uuid(7)) @db.Uuid
  policyId     String   @map("policy_id") @db.Uuid
  coverageId   String?  @map("coverage_id") @db.Uuid
  coverageName String   @map("coverage_name")
  sumInsured   Decimal  @map("sum_insured") @db.Decimal(15, 2)
  rate         Decimal? @db.Decimal(10, 6)
  deductible   Decimal? @db.Decimal(15, 2)
  premium      Decimal  @db.Decimal(15, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("policy_coverages")
}

// ─── Payment (spec §19) ──────────────────────────────────────────────────────

enum PaymentMethod {
  CASH
  TRANSFER
  CREDIT_CARD
  CHEQUE
  ONLINE
  OTHER

  @@map("payment_method")
}

enum PaymentStatus {
  ACTIVE
  CANCELLED

  @@map("payment_status")
}

model Payment {
  id            String        @id @default(uuid(7)) @db.Uuid
  paymentNo     String        @unique @map("payment_no")
  policyId      String        @map("policy_id") @db.Uuid
  paymentDate   DateTime      @map("payment_date") @db.Date
  amount        Decimal       @db.Decimal(15, 2)
  paymentMethod PaymentMethod @map("payment_method")
  referenceNo   String?       @map("reference_no")
  bank          String?
  invoiceId     String?       @map("invoice_id") @db.Uuid
  attachmentId  String?       @map("attachment_id") @db.Uuid
  status        PaymentStatus @default(ACTIVE)
  cancelReason  String?       @map("cancel_reason")
  remark        String?
  createdById   String?       @map("created_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  policy     Policy    @relation(fields: [policyId], references: [id])
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  attachment Document? @relation("payment_attachment", fields: [attachmentId], references: [id], onDelete: SetNull)
  createdBy  User?     @relation("payment_creator", fields: [createdById], references: [id], onDelete: SetNull)
  receipt    Receipt?

  @@index([policyId])
  @@index([invoiceId])
  @@index([status])
  @@map("payments")
}

// ─── Commission (spec §20) ───────────────────────────────────────────────────

enum CommissionType {
  COMPANY
  AGENT
  TEAM
  REFERRAL
  OTHER

  @@map("commission_type")
}

enum CommissionStatus {
  PENDING
  CALCULATED
  APPROVED
  PAYABLE
  PAID
  CANCELLED

  @@map("commission_status")
}

model Commission {
  id               String           @id @default(uuid(7)) @db.Uuid
  policyId         String           @map("policy_id") @db.Uuid
  agentId          String?          @map("agent_id") @db.Uuid
  commissionType   CommissionType   @map("commission_type")
  commissionRate   Decimal          @map("commission_rate") @db.Decimal(10, 4)
  commissionBase   Decimal          @map("commission_base") @db.Decimal(15, 2)
  commissionAmount Decimal          @map("commission_amount") @db.Decimal(15, 2)
  status           CommissionStatus @default(CALCULATED)
  paidDate         DateTime?        @map("paid_date") @db.Date
  remark           String?

  // V2 breakdown (Phase 4 D26). One row per payee of a policy: `commissionAmount` is this payee's share
  // before WHT; `grossAmount` is the whole policy commission (net premium × rate). NULL on V1 manual rows.
  grossAmount       Decimal?  @map("gross_amount") @db.Decimal(15, 2)
  sharePct          Decimal?  @map("share_pct") @db.Decimal(5, 2)
  brokerShareAmount Decimal?  @map("broker_share_amount") @db.Decimal(15, 2)
  whtRate           Decimal?  @map("wht_rate") @db.Decimal(5, 2)
  whtAmount         Decimal?  @map("wht_amount") @db.Decimal(15, 2)
  netAmount         Decimal?  @map("net_amount") @db.Decimal(15, 2)
  rateSource        String?   @map("rate_source")
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz(3)
  approvedById      String?   @map("approved_by_id") @db.Uuid
  payableAt         DateTime? @map("payable_at") @db.Timestamptz(3)
  statementId       String?   @map("statement_id") @db.Uuid

  createdById      String?          @map("created_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  policy    Policy @relation(fields: [policyId], references: [id])
  agent     User?  @relation("commission_agent", fields: [agentId], references: [id], onDelete: SetNull)
  createdBy User?  @relation("commission_creator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy User? @relation("commission_approver", fields: [approvedById], references: [id], onDelete: SetNull)
  statement  CommissionStatement? @relation(fields: [statementId], references: [id], onDelete: Restrict)
  adjustments CommissionAdjustment[]

  // Partial unique index (migration only): one live calculated row per (policy, type) — see DESIGN §5.3
  @@index([policyId])
  @@index([agentId])
  @@index([status])
  @@index([statementId])
  @@map("commissions")
}

// ─── Commission Adjustment & Statement (Phase 4 D27) ─────────────────────────

enum CommissionAdjustmentStatus {
  PENDING
  IN_STATEMENT
  SETTLED

  @@map("commission_adjustment_status")
}

/// A signed correction against an existing commission row; the original row is never edited (D-13).
/// `amount` is before WHT, like `Commission.commissionAmount`; WHT uses the original row's rate.
model CommissionAdjustment {
  id           String                     @id @default(uuid(7)) @db.Uuid
  commissionId String                     @map("commission_id") @db.Uuid
  policyId     String                     @map("policy_id") @db.Uuid
  agentId      String                     @map("agent_id") @db.Uuid
  amount       Decimal                    @db.Decimal(15, 2)
  whtRate      Decimal                    @map("wht_rate") @db.Decimal(5, 2)
  whtAmount    Decimal                    @map("wht_amount") @db.Decimal(15, 2)
  netAmount    Decimal                    @map("net_amount") @db.Decimal(15, 2)
  reason       String
  refType      String?                    @map("ref_type")
  refId        String?                    @map("ref_id")
  status       CommissionAdjustmentStatus @default(PENDING)
  statementId  String?                    @map("statement_id") @db.Uuid
  createdById  String?                    @map("created_by_id") @db.Uuid
  createdAt    DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  commission Commission           @relation(fields: [commissionId], references: [id])
  agent      User                 @relation("commission_adjustment_payee", fields: [agentId], references: [id])
  createdBy  User?                @relation("commission_adjustment_creator", fields: [createdById], references: [id], onDelete: SetNull)
  statement  CommissionStatement? @relation(fields: [statementId], references: [id], onDelete: Restrict)

  @@index([commissionId])
  @@index([agentId, status])
  @@index([statementId])
  @@map("commission_adjustments")
}

enum CommissionStatementStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED

  @@map("commission_statement_status")
}

/// One statement per payee per month (partial unique index in the migration, DESIGN §5.3).
model CommissionStatement {
  id            String                    @id @default(uuid(7)) @db.Uuid
  statementNo   String                    @unique @map("statement_no")
  agentId       String                    @map("agent_id") @db.Uuid
  period        String
  periodEnd     DateTime                  @map("period_end") @db.Date
  status        CommissionStatementStatus @default(DRAFT)
  shareTotal    Decimal                   @default(0) @map("share_total") @db.Decimal(15, 2)
  whtTotal      Decimal                   @default(0) @map("wht_total") @db.Decimal(15, 2)
  netTotal      Decimal                   @default(0) @map("net_total") @db.Decimal(15, 2)
  confirmedAt   DateTime?                 @map("confirmed_at") @db.Timestamptz(3)
  paidAt        DateTime?                 @map("paid_at") @db.Timestamptz(3)
  paidDate      DateTime?                 @map("paid_date") @db.Date
  paymentRef    String?                   @map("payment_ref")
  paidById      String?                   @map("paid_by_id") @db.Uuid
  cancelledAt   DateTime?                 @map("cancelled_at") @db.Timestamptz(3)
  cancelReason  String?                   @map("cancel_reason")
  createdById   String?                   @map("created_by_id") @db.Uuid
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  agent       User                   @relation("commission_statement_payee", fields: [agentId], references: [id])
  createdBy   User?                  @relation("commission_statement_creator", fields: [createdById], references: [id], onDelete: SetNull)
  paidBy      User?                  @relation("commission_statement_payer", fields: [paidById], references: [id], onDelete: SetNull)
  commissions Commission[]
  adjustments CommissionAdjustment[]

  @@index([agentId, period])
  @@index([status])
  @@map("commission_statements")
}

// ─── System Setting (Phase 4 D26: WHT rate, default agent share, override rate) ───

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation("system_setting_updater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

// ─── Task / Follow-up (spec §21) ─────────────────────────────────────────────

enum TaskType {
  CALL_CUSTOMER
  REQUEST_DOCUMENT
  REQUEST_QUOTATION
  FOLLOW_UP_QUOTATION
  SEND_PROPOSAL
  FOLLOW_UP_CUSTOMER
  FOLLOW_UP_PAYMENT
  FOLLOW_UP_POLICY
  FOLLOW_UP_INSURER
  RENEWAL_FOLLOW_UP
  CLAIM_FOLLOW_UP
  RENEWAL
  OTHER

  @@map("task_type")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED

  @@map("task_status")
}

model Task {
  id            String       @id @default(uuid(7)) @db.Uuid
  jobId         String?      @map("job_id") @db.Uuid
  customerId    String?      @map("customer_id") @db.Uuid
  policyId      String?      @map("policy_id") @db.Uuid
  assignedTo    String?      @map("assigned_to") @db.Uuid
  taskType      TaskType     @map("task_type")
  subject       String
  description   String?
  dueDate       DateTime?    @map("due_date") @db.Timestamptz(3)
  priority      TaskPriority @default(MEDIUM) @map("priority")
  status        TaskStatus   @default(TODO) @map("status")
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(3)
  completedById String?      @map("completed_by_id") @db.Uuid
  createdById   String?      @map("created_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  job         Job?      @relation(fields: [jobId], references: [id])
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  policy      Policy?   @relation(fields: [policyId], references: [id], onDelete: SetNull)
  assignee    User?     @relation("task_assignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  completedBy User?     @relation("task_completer", fields: [completedById], references: [id], onDelete: SetNull)
  createdBy   User?     @relation("task_creator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([customerId])
  @@index([policyId])
  @@index([assignedTo])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

// ─── Renewal (spec §23) ──────────────────────────────────────────────────────

enum RenewalStatus {
  PENDING
  IN_PROGRESS
  QUOTATION
  CUSTOMER_CONTACTED
  ACCEPTED
  REJECTED
  RENEWED
  LOST
  CANCELLED

  @@map("renewal_status")
}

model Renewal {
  id               String        @id @default(uuid(7)) @db.Uuid
  previousPolicyId String        @map("previous_policy_id") @db.Uuid
  newJobId         String?       @unique @map("new_job_id") @db.Uuid
  renewalDate      DateTime      @map("renewal_date") @db.Date
  targetExpiryDate DateTime      @map("target_expiry_date") @db.Date
  status           RenewalStatus @default(PENDING)
  assignedTo       String?       @map("assigned_to") @db.Uuid
  remark           String?
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  previousPolicy Policy @relation("renewal_previous_policy", fields: [previousPolicyId], references: [id])
  newJob         Job?   @relation("renewal_new_job", fields: [newJobId], references: [id])
  assignee       User?  @relation("renewal_assignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([previousPolicyId])
  @@index([status])
  @@map("renewals")
}

// ─── Notification (spec §24) ─────────────────────────────────────────────────

enum NotificationType {
  JOB_ASSIGNED
  DOCUMENT_MISSING
  QUOTATION_RECEIVED
  APPROVAL_REQUIRED
  APPROVAL_REQUESTED
  PROPOSAL_SENT
  CUSTOMER_ACCEPTED
  CUSTOMER_REJECTED
  POLICY_ISSUED
  PAYMENT_DUE
  PAYMENT_OVERDUE
  TASK_DUE
  TASK_OVERDUE
  RENEWAL_DUE
  UNDERWRITING_REQUESTED
  UNDERWRITING_APPROVED
  UNDERWRITING_INFO_REQUIRED
  UNDERWRITING_REJECTED
  QUOTATION_EXPIRING
  APPROVAL_REJECTED
  POLICY_EXPIRING

  @@map("notification_type")
}

model Notification {
  id         String           @id @default(uuid(7)) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       NotificationType
  title      String
  message    String
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id") @db.Uuid
  isRead     Boolean          @default(false) @map("is_read")
  readAt     DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation("notification_user", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

model NotificationPreference {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  email     Boolean          @default(true)
  inApp     Boolean          @default(true) @map("in_app")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation("notification_preferences", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("notification_preferences")
}

// ─── Invoice (spec §22 / Phase 4 Day 23) ─────────────────────────────────────

enum InvoiceType {
  INVOICE
  DEBIT_NOTE
  CREDIT_NOTE

  @@map("invoice_type")
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED

  @@map("invoice_status")
}

model Invoice {
  id             String        @id @default(uuid(7)) @db.Uuid
  invoiceNo      String        @unique @map("invoice_no")
  policyId       String        @map("policy_id") @db.Uuid
  customerId     String        @map("customer_id") @db.Uuid
  type           InvoiceType   @default(INVOICE) @map("type")
  installmentNo  Int?          @map("installment_no")
  amount         Decimal       @db.Decimal(15, 2)
  netAmount      Decimal       @map("net_amount") @db.Decimal(15, 2)
  stampDuty      Decimal       @default(0) @map("stamp_duty") @db.Decimal(15, 2)
  vat            Decimal       @default(0) @db.Decimal(15, 2)
  dueDate        DateTime      @map("due_date") @db.Date
  status         InvoiceStatus @default(PENDING)
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledById  String?       @map("cancelled_by_id") @db.Uuid
  dueReminderSentAt  DateTime? @map("due_reminder_sent_at") @db.Timestamptz(3)
  overdueNotifiedAt  DateTime? @map("overdue_notified_at") @db.Timestamptz(3)
  createdById    String?       @map("created_by_id") @db.Uuid
  updatedById    String?       @map("updated_by_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  policy        Policy   @relation(fields: [policyId], references: [id])
  customer      Customer @relation(fields: [customerId], references: [id])
  cancelledBy   User?    @relation("invoice_canceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  createdBy     User?    @relation("invoice_creator", fields: [createdById], references: [id], onDelete: SetNull)
  payments      Payment[]
  receipts      Receipt[]
  refunds       Refund[]

  @@index([policyId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

enum ReceiptStatus {
  ISSUED
  VOID

  @@map("receipt_status")
}

model Receipt {
  id          String        @id @default(uuid(7)) @db.Uuid
  receiptNo   String        @unique @map("receipt_no")
  paymentId   String        @unique @map("payment_id") @db.Uuid
  invoiceId   String        @map("invoice_id") @db.Uuid
  amount      Decimal       @db.Decimal(15, 2)
  status      ReceiptStatus @default(ISSUED)
  issuedAt    DateTime      @default(now()) @map("issued_at") @db.Timestamptz(3)
  voidedAt    DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidReason  String?       @map("void_reason")
  voidedById  String?       @map("voided_by_id") @db.Uuid
  createdById String?       @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment   Payment @relation(fields: [paymentId], references: [id])
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  voidedBy  User?   @relation("receipt_voider", fields: [voidedById], references: [id], onDelete: SetNull)
  createdBy User?   @relation("receipt_creator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([status])
  @@map("receipts")
}

// ─── Phase 5: Endorsement, Policy Versions, Cancellation, Refunds ────────────

enum EndorsementType {
  CHANGE_CUSTOMER
  CHANGE_ADDRESS
  CHANGE_COVERAGE
  CHANGE_SUM_INSURED
  ADD_ASSET
  REMOVE_ASSET
  CHANGE_VEHICLE
  CHANGE_EFFECTIVE_DATE
  OTHER

  @@map("endorsement_type")
}

enum EndorsementStatus {
  DRAFT
  REQUESTED
  REVIEWING
  APPROVED
  REJECTED
  ISSUED
  CANCELLED

  @@map("endorsement_status")
}

enum PremiumAdjustmentType {
  ADDITIONAL_PREMIUM
  REFUND_PREMIUM
  NO_CHANGE

  @@map("premium_adjustment_type")
}

model Endorsement {
  id                    String                @id @default(uuid(7)) @db.Uuid
  endorsementNo         String                @unique @map("endorsement_no")
  policyId              String                @map("policy_id") @db.Uuid
  type                  EndorsementType
  status                EndorsementStatus     @default(DRAFT)
  effectiveDate         DateTime              @map("effective_date") @db.Date
  changes               Json
  premiumAdjustmentType PremiumAdjustmentType @default(NO_CHANGE) @map("premium_adjustment_type")
  netAdjustment         Decimal               @default(0) @map("net_adjustment") @db.Decimal(15, 2)
  stampDuty             Decimal               @default(0) @map("stamp_duty") @db.Decimal(15, 2)
  vat                   Decimal               @default(0) @db.Decimal(15, 2)
  totalAdjustment       Decimal               @default(0) @map("total_adjustment") @db.Decimal(15, 2)
  remark                String?
  rejectionReason       String?               @map("rejection_reason")
  insurerDocumentId     String?               @map("insurer_document_id") @db.Uuid
  requestedById         String?               @map("requested_by_id") @db.Uuid
  requestedAt           DateTime?             @map("requested_at") @db.Timestamptz(3)
  reviewedById          String?               @map("reviewed_by_id") @db.Uuid
  reviewedAt            DateTime?             @map("reviewed_at") @db.Timestamptz(3)
  requiredApproverRole  String?               @map("required_approver_role")
  approvedById          String?               @map("approved_by_id") @db.Uuid
  approvedAt            DateTime?             @map("approved_at") @db.Timestamptz(3)
  issuedById            String?               @map("issued_by_id") @db.Uuid
  issuedAt              DateTime?             @map("issued_at") @db.Timestamptz(3)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  policy          Policy    @relation(fields: [policyId], references: [id])
  insurerDocument Document? @relation("endorsement_document", fields: [insurerDocumentId], references: [id], onDelete: SetNull)
  requestedBy     User?     @relation("endorsement_requester", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy      User?     @relation("endorsement_reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedBy      User?     @relation("endorsement_approver", fields: [approvedById], references: [id], onDelete: SetNull)
  issuedBy        User?     @relation("endorsement_issuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([policyId])
  @@index([status])
  @@index([type])
  @@map("endorsements")
}

model PolicyVersion {
  id              String   @id @default(uuid(7)) @db.Uuid
  policyId        String   @map("policy_id") @db.Uuid
  version         Int
  snapshot        Json
  reason          String?
  endorsementId   String?  @map("endorsement_id") @db.Uuid
  createdById     String?  @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, version])
  @@index([policyId])
  @@map("policy_versions")
}

model ShortRateTable {
  id          String   @id @default(uuid(7)) @db.Uuid
  daysFrom    Int      @map("days_from")
  daysTo      Int      @map("days_to")
  ratePercent Decimal  @map("rate_percent") @db.Decimal(5, 2)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("short_rate_tables")
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED

  @@map("refund_status")
}

model Refund {
  id            String        @id @default(uuid(7)) @db.Uuid
  refundNo      String        @unique @map("refund_no")
  creditNoteId  String        @map("credit_note_id") @db.Uuid
  amount        Decimal       @db.Decimal(15, 2)
  status        RefundStatus  @default(REQUESTED)
  reason        String?
  rejectionReason String?     @map("rejection_reason")
  requestedById String?       @map("requested_by_id") @db.Uuid
  requestedAt   DateTime      @default(now()) @map("requested_at") @db.Timestamptz(3)
  approvedById  String?       @map("approved_by_id") @db.Uuid
  approvedAt    DateTime?     @map("approved_at") @db.Timestamptz(3)
  processedById String?       @map("processed_by_id") @db.Uuid
  processedAt   DateTime?     @map("processed_at") @db.Timestamptz(3)
  paymentMethod PaymentMethod? @map("payment_method")
  bank          String?
  referenceNo   String?       @map("reference_no")
  attachmentId  String?       @map("attachment_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  creditNote  Invoice   @relation(fields: [creditNoteId], references: [id])
  attachment  Document? @relation("refund_attachment", fields: [attachmentId], references: [id], onDelete: SetNull)
  requestedBy User?     @relation("refund_requester", fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy  User?     @relation("refund_approver", fields: [approvedById], references: [id], onDelete: SetNull)
  processedBy User?     @relation("refund_processor", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([creditNoteId])
  @@index([status])
  @@map("refunds")
}
