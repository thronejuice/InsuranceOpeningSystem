  job      Job               @relation(fields: [jobId], references: [id])
  coverage InsuranceCoverage @relation(fields: [coverageId], references: [id])

  @@unique([jobId, coverageId])
  @@index([jobId])
  @@map("job_coverages")
}

// ─── Documents (spec §36) ─────────────────────────────────────────────────────

enum DocumentStatus {
  REQUIRED
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED

  @@map("document_status")
}

model Document {
  id           String         @id @default(uuid(7)) @db.Uuid
  jobId        String         @map("job_id") @db.Uuid
  documentType DocumentType   @map("document_type")
  originalName String         @map("original_name")
  storedName   String         @map("stored_name")
  mimeType     String         @map("mime_type")
  size         Int
  storagePath  String         @map("storage_path")
  version      Int            @default(1)
  status       DocumentStatus @default(UPLOADED)
  uploadedById String?        @map("uploaded_by_id") @db.Uuid
  verifiedById String?        @map("verified_by_id") @db.Uuid
  verifiedAt   DateTime?      @map("verified_at") @db.Timestamptz(3)
  expiryDate   DateTime?      @map("expiry_date") @db.Date
  remark       String?
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  job        Job   @relation(fields: [jobId], references: [id])
  uploadedBy User? @relation("document_uploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  verifiedBy User? @relation("document_verifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  proposalAcceptances ProposalAcceptance[]
  binderDocuments     Binding[]
  policyDocuments     Policy[]            @relation("policy_document")

  @@index([jobId, status])
  @@index([jobId, documentType])
  @@index([expiryDate])
  @@map("documents")
}

// ─── Underwriting (Phase 1 Day 8) ─────────────────────────────────────────────

enum UnderwritingStatus {
  PENDING
  INFO_REQUIRED
  APPROVED
  REJECTED

  @@map("underwriting_status")
}

model Underwriting {
  id                String             @id @default(uuid(7)) @db.Uuid
  jobId             String             @map("job_id") @db.Uuid
  version           Int                @default(1)
  status            UnderwritingStatus @default(PENDING)
  riskLevel         String?            @map("risk_level")
  riskScore         Float?             @map("risk_score")
  requestedById     String?            @map("requested_by_id") @db.Uuid
  requestedAt       DateTime           @default(now()) @map("requested_at") @db.Timestamptz(3)
  underwriterId     String?            @map("underwriter_id") @db.Uuid
