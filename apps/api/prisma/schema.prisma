  jobRiskId  String   @map("job_risk_id") @db.Uuid
  fieldCode  String   @map("field_code")
  fieldValue String?  @map("field_value")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  jobRisk JobRisk @relation(fields: [jobRiskId], references: [id], onDelete: Cascade)

  @@unique([jobRiskId, fieldCode])
  @@index([jobRiskId])
