// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity & Access (spec §4, §35, DESIGN §8) ───────────────────────────

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  username     String    @unique
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  isActive     Boolean   @default(true) @map("is_active")
  branchId     String?   @map("branch_id") @db.Uuid
  managerId    String?   @map("manager_id") @db.Uuid
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById  String?   @map("created_by_id") @db.Uuid
  updatedById  String?   @map("updated_by_id") @db.Uuid
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  branch        Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  manager       User?     @relation("user_manager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates  User[]    @relation("user_manager")
  roles         UserRole[]
  refreshTokens RefreshToken[]
  activityLogs  ActivityLog[]
  agentJobs              Job[]              @relation("job_agent")
  assigneeJobs           Job[]              @relation("job_assignee")
  brokerStaffJobs        Job[]              @relation("job_broker_staff")
  fromJobAssignments    JobAssignmentHistory[] @relation("assignment_from_user")
  toJobAssignments      JobAssignmentHistory[] @relation("assignment_to_user")
  changedJobAssignments JobAssignmentHistory[] @relation("assignment_changed_by")
  changedStatusHistories JobStatusHistory[]
  uploadedDocuments      Document[]         @relation("document_uploader")
  verifiedDocuments      Document[]         @relation("document_verifier")
  requestedQuotations    Quotation[]        @relation("quotation_requester")
  createdProposals       Proposal[]         @relation("proposal_creator")
  requestedApprovals     Approval[]         @relation("approval_requester")
  approvedApprovals      Approval[]         @relation("approval_approver")
  resubmittedApprovals   Approval[]         @relation("approval_resubmitter")
  confirmedBindings      Binding[]          @relation("binding_confirmer")
  createdPolicies        Policy[]           @relation("policy_creator")
  createdPayments        Payment[]          @relation("payment_creator")
  agentCommissions       Commission[]       @relation("commission_agent")
  createdCommissions     Commission[]       @relation("commission_creator")
  assignedTasks          Task[]             @relation("task_assignee")
  createdTasks           Task[]             @relation("task_creator")
  completedTasks         Task[]             @relation("task_completer")
  assignedRenewals       Renewal[]          @relation("renewal_assignee")
  notifications          Notification[]     @relation("notification_user")
  notificationPreferences NotificationPreference[] @relation("notification_preferences")
  requestedUnderwritings Underwriting[]     @relation("underwriting_requester")
  reviewedUnderwritings  Underwriting[]     @relation("underwriting_reviewer")
  createdQuotationVersions QuotationVersion[] @relation("quotation_version_creator")
  recordedProposalAcceptances ProposalAcceptance[] @relation("proposal_acceptance_recorder")

  @@index([branchId])
  @@index([managerId])
  @@map("users")
}

enum DataScope {
  OWN
  ASSIGNED
  TEAM
  BRANCH
  ALL

  @@map("data_scope")
}

model Role {
  id          String    @id @default(uuid(7)) @db.Uuid
  code        String    @unique
  name        String
  description String?
  dataScope   DataScope @default(OWN) @map("data_scope")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// DESIGN §5.1 — stores only the hash so a leaked DB cannot replay tokens
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum ActivitySource {
  WEB
  API
  JOB
  IMPORT

  @@map("activity_source")
}

model ActivityLog {
  id          String         @id @default(uuid(7)) @db.Uuid
  /// FK to jobs is added once the jobs table exists (Phase 2)
  jobId       String?        @map("job_id") @db.Uuid
  userId      String?        @map("user_id") @db.Uuid
  action      String
  entityType  String         @map("entity_type")
  entityId    String?        @map("entity_id")
  oldValue    Json?          @map("old_value")
  newValue    Json?          @map("new_value")
  source      ActivitySource @default(WEB)
  remark      String?
  description String?
  ipAddress   String?        @map("ip_address")
  userAgent   String?        @map("user_agent")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  job  Job?  @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ─── Customer (spec §7) ────────────────────────────────────────────────────

enum CustomerType {
  INDIVIDUAL
  CORPORATE

  @@map("customer_type")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE

  @@map("customer_status")
}

enum AddressType {
  HOME
  OFFICE
  BILLING
  SHIPPING
  OTHER

  @@map("address_type")
}

model Customer {
  id           String         @id @default(uuid(7)) @db.Uuid
  customerCode String         @unique @map("customer_code")
  customerType CustomerType   @map("customer_type")
  firstName    String?        @map("first_name")
  lastName     String?        @map("last_name")
  companyName  String?        @map("company_name")
  taxId        String?        @map("tax_id")
  citizenId    String?        @map("citizen_id")
  phone        String?
  mobile       String?
  email        String?
  status       CustomerStatus @default(ACTIVE)
  remark       String?
  createdById  String?        @map("created_by_id") @db.Uuid
  updatedById  String?        @map("updated_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(3)

  addresses  CustomerAddress[]
  contacts   CustomerContact[]
  jobs       Job[]
  proposals  Proposal[]

  @@index([customerType])
  @@index([status])
  @@index([email])
  @@index([taxId])
  @@map("customers")
}

model CustomerAddress {
  id          String      @id @default(uuid(7)) @db.Uuid
  customerId  String      @map("customer_id") @db.Uuid
  addressType AddressType @map("address_type")
  addressLine String      @map("address_line")
  subDistrict String?     @map("sub_district")
  district    String?
  province    String?
  postalCode  String?     @map("postal_code")
  country     String?     @default("Thailand")
  isPrimary   Boolean     @default(false) @map("is_primary")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerContact {
  id          String   @id @default(uuid(7)) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  contactName String   @map("contact_name")
  position    String?
  department  String?
  phone       String?
  mobile      String?
  email       String?
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_contacts")
}

// ─── Master Data (spec §8, §10, §11, §12.2, §16.2) ──────────────────────────

model Branch {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  name      String
  address   String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users     User[]
  jobs      Job[]

  @@map("branches")
}

model InsuranceType {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products      InsuranceProduct[]
  jobs          Job[]
  approvalRules ApprovalRule[]

  @@map("insurance_types")
}

model InsuranceProduct {
  id                  String   @id @default(uuid(7)) @db.Uuid
  insuranceTypeId     String   @map("insurance_type_id") @db.Uuid
  code                String   @unique
  name                String
  description         String?
  requireDocsOnSubmit Boolean  @default(false) @map("require_docs_on_submit")
  requireDocsOnBind   Boolean  @default(false) @map("require_docs_on_bind")
  requireUnderwriting Boolean  @default(false) @map("require_underwriting")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  insuranceType     InsuranceType         @relation(fields: [insuranceTypeId], references: [id])
  riskFields        RiskFieldDefinition[]
  coverages         InsuranceCoverage[]
  documentChecklist DocumentChecklist[]
  commissionRates   CommissionRate[]
  jobs              Job[]
  approvalRules     ApprovalRule[]

  @@index([insuranceTypeId])
  @@map("insurance_products")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE

  @@map("company_status")
}

model InsuranceCompany {
  id          String        @id @default(uuid(7)) @db.Uuid
  code        String        @unique
  name        String
  taxId       String?       @map("tax_id")
  contactName String?       @map("contact_name")
  phone       String?
  email       String?
  address     String?
  status      CompanyStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(3)

  quotations      Quotation[]
  policies        Policy[]
  commissionRates CommissionRate[]
  bindings        Binding[]

  @@index([status])
  @@map("insurance_companies")
}

model InsuranceCoverage {
  id                String   @id @default(uuid(7)) @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  code              String
  name              String
  description       String?
  defaultSumInsured Decimal? @map("default_sum_insured") @db.Decimal(15, 2)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product        InsuranceProduct @relation(fields: [productId], references: [id])
  jobCoverages   JobCoverage[]
  quotationItems QuotationItem[]

  @@unique([productId, code])
  @@index([productId])
  @@map("insurance_coverages")
}

enum RiskFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
  FILE
  JSON

  @@map("risk_field_type")
}

model RiskFieldDefinition {
  id             String        @id @default(uuid(7)) @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  fieldCode      String        @map("field_code")
  fieldName      String        @map("field_name")
  fieldType      RiskFieldType @map("field_type")
  isRequired     Boolean       @default(false) @map("is_required")
  validationRule String?       @map("validation_rule")
  sortOrder      Int           @default(0) @map("sort_order")
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  product InsuranceProduct @relation(fields: [productId], references: [id])

  @@unique([productId, fieldCode])
  @@index([productId, sortOrder])
  @@map("risk_field_definitions")
}

enum DocumentType {
  ID_CARD
  COMPANY_REGISTRATION
  TAX_DOCUMENT
  VEHICLE_BOOK
  PREVIOUS_POLICY
  VEHICLE_PHOTO
  RISK_SURVEY
  QUOTATION
  PROPOSAL
  POLICY
  INVOICE
  RECEIPT
  OTHER

  @@map("document_type")
}

model DocumentChecklist {
  id           String       @id @default(uuid(7)) @db.Uuid
  productId    String       @map("product_id") @db.Uuid
  documentType DocumentType @map("document_type")
  isRequired   Boolean      @default(true) @map("is_required")
  sortOrder    Int          @default(0) @map("sort_order")
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  product InsuranceProduct @relation(fields: [productId], references: [id])

  @@unique([productId, documentType])
  @@index([productId])
  @@map("document_checklists")
}

// ─── Commission Rate Master (Phase 2 Day 11, D26, D42) ─────────────────────────

model CommissionRate {
  id                 String           @id @default(uuid(7)) @db.Uuid
  insuranceCompanyId String           @map("insurance_company_id") @db.Uuid
  productId          String           @map("product_id") @db.Uuid
  rate               Decimal          @db.Decimal(10, 4)
  effectiveFrom      DateTime         @map("effective_from") @db.Date
  effectiveTo        DateTime?        @map("effective_to") @db.Date
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?        @map("deleted_at") @db.Timestamptz(3)

  insuranceCompany   InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id])
  product            InsuranceProduct @relation(fields: [productId], references: [id])

  @@index([insuranceCompanyId])
  @@index([productId])
  @@index([effectiveFrom, effectiveTo])
  @@map("commission_rates")
}

// ─── Payment Term Master (Phase 2 Day 13 / OQ-2) ─────────────────────────────

model PaymentTerm {
  id             String     @id @default(uuid(7)) @db.Uuid
  code           String     @unique
  name           String
  description    String?
  installments   Int        @default(1)
  intervalMonths Int        @default(0) @map("interval_months")
  firstDueDays   Int        @default(30) @map("first_due_days")
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  proposals      Proposal[]

  @@map("payment_terms")
}

enum ApprovalConditionField {
  PREMIUM
  DISCOUNT
  SUM_INSURED

  @@map("approval_condition_field")
}

enum ApprovalConditionOperator {
  LT
  LTE
  GT
  GTE
  EQ

  @@map("approval_condition_operator")
}

enum ApprovalRoleTarget {
  SUPERVISOR
  MANAGER
  ADMIN

  @@map("approval_role_target")
}

enum ApprovalEntityType {
  JOB
  ENDORSEMENT

  @@map("approval_entity_type")
}

model ApprovalRule {
  id                String                    @id @default(uuid(7)) @db.Uuid
  name              String
  entityType        ApprovalEntityType        @default(JOB) @map("entity_type")
  productId         String?                   @map("product_id") @db.Uuid
  insuranceTypeId   String?                   @map("insurance_type_id") @db.Uuid
  riskLevel         String?                   @map("risk_level")
  conditionField    ApprovalConditionField    @map("condition_field")
  conditionOperator ApprovalConditionOperator @map("condition_operator")
  thresholdValue    Decimal                   @map("threshold_value") @db.Decimal(15, 2)
  approverRole      ApprovalRoleTarget        @map("approver_role")
  active            Boolean                   @default(true)
  sortOrder         Int                       @default(0) @map("sort_order")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  product           InsuranceProduct?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  insuranceType     InsuranceType?            @relation(fields: [insuranceTypeId], references: [id], onDelete: SetNull)

  @@index([entityType])
  @@index([productId])
  @@index([insuranceTypeId])
  @@map("approval_rules")
}

// ─── Company profile (letterhead for customer-facing documents) ─────────────

/// Singleton row (id = "default") — broker/agent letterhead printed on the proposal PDF.
model CompanyProfile {
  id              String   @id @default("default")
  nameTh          String   @map("name_th")
  nameEn          String?  @map("name_en")
  addressTh       String?  @map("address_th")
  addressEn       String?  @map("address_en")
  taxId           String?  @map("tax_id")
  brokerLicenseNo String?  @map("broker_license_no")
  phone           String?
  email           String?
  website         String?
  /// Storage path of the uploaded logo (PNG/JPG)
  logoPath        String?  @map("logo_path")
  logoMimeType    String?  @map("logo_mime_type")
  /// Standard terms printed on the proposal, one per line
  proposalTerms   String?  @map("proposal_terms")
  /// [{ bankName, branch, accountName, accountNo }]
  bankAccounts    Json     @default("[]") @map("bank_accounts")
  updatedById     String?  @map("updated_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("company_profile")
}

// ─── Running number (DESIGN §5.2) ──────────────────────────────────────────

model DocumentSequence {
  prefix    String
  /// 0 = sequence that does not reset yearly (e.g. CUS)
  year      Int
  lastValue Int      @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([prefix, year])
  @@map("document_sequences")
}

// ─── Job (spec §9, §6, DESIGN §7) ────────────────────────────────────────────

enum JobStatus {
  DRAFT
  OPEN
  WAITING_INFORMATION
  QUOTATION_REQUESTED
  QUOTATION_RECEIVED
  QUOTATION_SELECTED
  PROPOSAL_SENT
  WAITING_CUSTOMER
  CUSTOMER_ACCEPTED
  CUSTOMER_REJECTED
  WAITING_APPROVAL
  APPROVAL_REJECTED
  APPROVED
  BINDING
  POLICY_PENDING
  POLICY_ISSUED
  CANCELLED
  CLOSED
  EXPIRED
  RENEWAL

  @@map("job_status")
}

enum JobPriority {
  NORMAL
  HIGH
  URGENT

  @@map("job_priority")
}

model Job {
  id                  String      @id @default(uuid(7)) @db.Uuid
  jobNo               String      @unique @map("job_no")
  customerId          String      @map("customer_id") @db.Uuid
  insuranceTypeId     String      @map("insurance_type_id") @db.Uuid
  productId           String      @map("product_id") @db.Uuid
  agentId             String      @map("agent_id") @db.Uuid
  assignedTo          String?     @map("assigned_to") @db.Uuid
  brokerStaffId       String?     @map("broker_staff_id") @db.Uuid
  branchId            String?     @map("branch_id") @db.Uuid
  source              String?
  priority            JobPriority @default(NORMAL)
  status              JobStatus   @default(DRAFT)
  effectiveDate       DateTime    @map("effective_date") @db.Date
  expiryDate          DateTime?   @map("expiry_date") @db.Date
  remark              String?
  version             Int         @default(1)
  selectedQuotationId String?     @unique @map("selected_quotation_id") @db.Uuid
  previousPolicyId    String?     @map("previous_policy_id") @db.Uuid
  createdById         String?     @map("created_by_id") @db.Uuid
  updatedById         String?     @map("updated_by_id") @db.Uuid
  deletedAt           DateTime?   @map("deleted_at") @db.Timestamptz(3)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Cancel request (D-26)
  cancelRequestedAt   DateTime?   @map("cancel_requested_at") @db.Timestamptz(3)
  cancelRequestedById String?     @map("cancel_requested_by_id") @db.Uuid
  cancelRequestReason String?     @map("cancel_request_reason")
  cancellationReason  String?     @map("cancellation_reason")
  cancelledAt         DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  cancelledById       String?     @map("cancelled_by_id") @db.Uuid

  customer            Customer               @relation(fields: [customerId], references: [id])
  insuranceType       InsuranceType          @relation(fields: [insuranceTypeId], references: [id])
  product             InsuranceProduct       @relation(fields: [productId], references: [id])
  agent               User                   @relation("job_agent", fields: [agentId], references: [id])
  assignee            User?                  @relation("job_assignee", fields: [assignedTo], references: [id])
  brokerStaff         User?                  @relation("job_broker_staff", fields: [brokerStaffId], references: [id])
  branch              Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  statusHistories     JobStatusHistory[]
  assignmentHistories JobAssignmentHistory[]
  activityLogs        ActivityLog[]
  risk                JobRisk?
  coverages           JobCoverage[]
  documents           Document[]
  quotations          Quotation[]            @relation("job_quotations")
  selectedQuotation   Quotation?             @relation("job_selected_quotation", fields: [selectedQuotationId], references: [id])
  proposals           Proposal[]
