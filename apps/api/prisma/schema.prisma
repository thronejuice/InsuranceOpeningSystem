  @@index([customerId])
  @@index([agentId])
  @@index([brokerStaffId])
  @@index([branchId])
  @@index([status])
  @@index([productId])
  @@index([effectiveDate])
  @@index([deletedAt])
  @@map("jobs")
}

enum AssignmentRole {
  AGENT
  BROKER_STAFF
  MANAGER

  @@map("assignment_role")
}

model JobAssignmentHistory {
