  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@map("idempotency_keys")
}

// ─── Binding (spec §17) ──────────────────────────────────────────────────────

enum BindingStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  REJECTED
  CANCELLED

  @@map("binding_status")
}

model Binding {
  id               String        @id @default(uuid(7)) @db.Uuid
  jobId            String        @unique @map("job_id") @db.Uuid
  quotationId      String        @map("quotation_id") @db.Uuid
  status           BindingStatus @default(SUBMITTED)
  bindingDate      DateTime      @map("binding_date") @db.Date
  effectiveDate    DateTime      @map("effective_date") @db.Date
  expiryDate       DateTime?     @map("expiry_date") @db.Date
  binderNumber     String?       @map("binder_number")
  binderDate       DateTime?     @map("binder_date") @db.Date
  insurerId        String?       @map("insurer_id") @db.Uuid
  premium          Decimal?      @map("premium") @db.Decimal(15, 2)
  paymentCondition String?       @map("payment_condition")
  underwriter      String?
  binderDocumentId String?       @map("binder_document_id") @db.Uuid
  confirmedById    String?       @map("confirmed_by_id") @db.Uuid
  remark           String?
  rejectionReason  String?       @map("rejection_reason")
  cancelledAt      DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledById    String?       @map("cancelled_by_id") @db.Uuid
  idempotencyKey   String?       @unique @map("idempotency_key")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  job            Job               @relation(fields: [jobId], references: [id])
  quotation      Quotation         @relation(fields: [quotationId], references: [id])
  insurer        InsuranceCompany? @relation(fields: [insurerId], references: [id], onDelete: SetNull)
  binderDocument Document?         @relation(fields: [binderDocumentId], references: [id], onDelete: SetNull)
  confirmedBy    User?             @relation("binding_confirmer", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([insurerId])
  @@index([status])
  @@map("bindings")
}

// ─── Policy (spec §18) ───────────────────────────────────────────────────────

enum PolicyStatus {
  DRAFT
  PENDING
  ACTIVE
  EXPIRING
  EXPIRED
  CANCEL_REQUESTED
  CANCELLED
  RENEWED

  @@map("policy_status")
}

model Policy {
  id                 String       @id @default(uuid(7)) @db.Uuid
  policyNo           String       @unique @map("policy_no")
  jobId              String       @unique @map("job_id") @db.Uuid
  quotationId        String       @map("quotation_id") @db.Uuid
  insuranceCompanyId String       @map("insurance_company_id") @db.Uuid
  policyType         String?      @map("policy_type")
  effectiveDate      DateTime     @map("effective_date") @db.Date
  expiryDate         DateTime?    @map("expiry_date") @db.Date
  sumInsured         Decimal?     @map("sum_insured") @db.Decimal(15, 2)
  deductible         Decimal?     @map("deductible") @db.Decimal(15, 2)
  policyDocumentId   String?      @map("policy_document_id") @db.Uuid
  grossPremium       Decimal      @default(0) @map("gross_premium") @db.Decimal(15, 2)
  discount           Decimal      @default(0) @db.Decimal(15, 2)
  netPremium         Decimal      @default(0) @map("net_premium") @db.Decimal(15, 2)
  tax                Decimal      @default(0) @db.Decimal(15, 2)
  stampDuty          Decimal      @default(0) @map("stamp_duty") @db.Decimal(15, 2)
  totalPremium       Decimal      @default(0) @map("total_premium") @db.Decimal(15, 2)
  status             PolicyStatus @default(PENDING)
  paymentDueDate     DateTime?    @map("payment_due_date") @db.Date
  issuedAt           DateTime?    @map("issued_at") @db.Timestamptz(3)
  remark             String?
  version            Int          @default(1)
  createdById        String?      @map("created_by_id") @db.Uuid
  updatedById        String?      @map("updated_by_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  job              Job              @relation(fields: [jobId], references: [id])
  quotation        Quotation        @relation(fields: [quotationId], references: [id])
  insuranceCompany InsuranceCompany @relation(fields: [insuranceCompanyId], references: [id])
  policyDocument   Document?        @relation("policy_document", fields: [policyDocumentId], references: [id], onDelete: SetNull)
  createdBy        User?            @relation("policy_creator", fields: [createdById], references: [id], onDelete: SetNull)
  coverages        PolicyCoverage[]
  payments         Payment[]
  commissions      Commission[]
  renewals         Renewal[]        @relation("renewal_previous_policy")

  @@index([status])
  @@index([policyDocumentId])
  @@map("policies")
}

model PolicyCoverage {
  id           String   @id @default(uuid(7)) @db.Uuid
  policyId     String   @map("policy_id") @db.Uuid
  coverageId   String?  @map("coverage_id") @db.Uuid
  coverageName String   @map("coverage_name")
  sumInsured   Decimal  @map("sum_insured") @db.Decimal(15, 2)
  rate         Decimal? @db.Decimal(10, 6)
  deductible   Decimal? @db.Decimal(15, 2)
  premium      Decimal  @db.Decimal(15, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("policy_coverages")
}

// ─── Payment (spec §19) ──────────────────────────────────────────────────────

enum PaymentMethod {
  CASH
  TRANSFER
  CREDIT_CARD
  CHEQUE
  ONLINE
  OTHER

  @@map("payment_method")
}

enum PaymentStatus {
  ACTIVE
  CANCELLED

  @@map("payment_status")
}

model Payment {
  id            String        @id @default(uuid(7)) @db.Uuid
  paymentNo     String        @unique @map("payment_no")
  policyId      String        @map("policy_id") @db.Uuid
  paymentDate   DateTime      @map("payment_date") @db.Date
  amount        Decimal       @db.Decimal(15, 2)
  paymentMethod PaymentMethod @map("payment_method")
  referenceNo   String?       @map("reference_no")
  status        PaymentStatus @default(ACTIVE)
  cancelReason  String?       @map("cancel_reason")
  remark        String?
  createdById   String?       @map("created_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  policy    Policy @relation(fields: [policyId], references: [id])
  createdBy User?  @relation("payment_creator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([policyId])
  @@index([status])
  @@map("payments")
}

// ─── Commission (spec §20) ───────────────────────────────────────────────────

enum CommissionType {
  COMPANY
  AGENT
  TEAM
  REFERRAL
  OTHER

  @@map("commission_type")
}

enum CommissionStatus {
  PENDING
  CALCULATED
  APPROVED
  PAID
  CANCELLED

  @@map("commission_status")
}

model Commission {
  id               String           @id @default(uuid(7)) @db.Uuid
  policyId         String           @map("policy_id") @db.Uuid
  agentId          String?          @map("agent_id") @db.Uuid
  commissionType   CommissionType   @map("commission_type")
  commissionRate   Decimal          @map("commission_rate") @db.Decimal(10, 4)
  commissionBase   Decimal          @map("commission_base") @db.Decimal(15, 2)
  commissionAmount Decimal          @map("commission_amount") @db.Decimal(15, 2)
  status           CommissionStatus @default(CALCULATED)
  paidDate         DateTime?        @map("paid_date") @db.Date
  remark           String?
  createdById      String?          @map("created_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  policy    Policy @relation(fields: [policyId], references: [id])
  agent     User?  @relation("commission_agent", fields: [agentId], references: [id], onDelete: SetNull)
  createdBy User?  @relation("commission_creator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([policyId])
  @@index([agentId])
  @@index([status])
  @@map("commissions")
}

// ─── Task / Follow-up (spec §21) ─────────────────────────────────────────────

enum TaskType {
  CALL_CUSTOMER
  REQUEST_DOCUMENT
  REQUEST_QUOTATION
  FOLLOW_UP_QUOTATION
  SEND_PROPOSAL
  FOLLOW_UP_CUSTOMER
  FOLLOW_UP_PAYMENT
  FOLLOW_UP_POLICY
  RENEWAL
  OTHER

  @@map("task_type")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED

  @@map("task_status")
}

model Task {
  id          String       @id @default(uuid(7)) @db.Uuid
  jobId       String       @map("job_id") @db.Uuid
  assignedTo  String?      @map("assigned_to") @db.Uuid
  taskType    TaskType     @map("task_type")
  subject     String
  description String?
  dueDate     DateTime?    @map("due_date") @db.Timestamptz(3)
  priority    TaskPriority @default(MEDIUM) @map("priority")
  status      TaskStatus   @default(TODO) @map("status")
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(3)
  completedById String?    @map("completed_by_id") @db.Uuid
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  job         Job   @relation(fields: [jobId], references: [id])
  assignee    User? @relation("task_assignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  completedBy User? @relation("task_completer", fields: [completedById], references: [id], onDelete: SetNull)
  createdBy   User? @relation("task_creator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([assignedTo])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

// ─── Renewal (spec §23) ──────────────────────────────────────────────────────

enum RenewalStatus {
  PENDING
  IN_PROGRESS
  QUOTATION
  CUSTOMER_CONTACTED
  ACCEPTED
  REJECTED
  RENEWED
  LOST
  CANCELLED

  @@map("renewal_status")
}

model Renewal {
  id               String        @id @default(uuid(7)) @db.Uuid
  previousPolicyId String        @map("previous_policy_id") @db.Uuid
  newJobId         String?       @unique @map("new_job_id") @db.Uuid
  renewalDate      DateTime      @map("renewal_date") @db.Date
  targetExpiryDate DateTime      @map("target_expiry_date") @db.Date
  status           RenewalStatus @default(PENDING)
  assignedTo       String?       @map("assigned_to") @db.Uuid
  remark           String?
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  previousPolicy Policy @relation("renewal_previous_policy", fields: [previousPolicyId], references: [id])
  newJob         Job?   @relation("renewal_new_job", fields: [newJobId], references: [id])
  assignee       User?  @relation("renewal_assignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([previousPolicyId])
  @@index([status])
  @@map("renewals")
}

// ─── Notification (spec §24) ─────────────────────────────────────────────────

enum NotificationType {
  JOB_ASSIGNED
  DOCUMENT_MISSING
  QUOTATION_RECEIVED
  APPROVAL_REQUIRED
  APPROVAL_REQUESTED
  PROPOSAL_SENT
  CUSTOMER_ACCEPTED
  CUSTOMER_REJECTED
  POLICY_ISSUED
  PAYMENT_OVERDUE
  TASK_DUE
  RENEWAL_DUE
  UNDERWRITING_REQUESTED
  UNDERWRITING_APPROVED
  UNDERWRITING_INFO_REQUIRED
  UNDERWRITING_REJECTED
  QUOTATION_EXPIRING
  APPROVAL_REJECTED
  POLICY_EXPIRING

  @@map("notification_type")
}

model Notification {
  id         String           @id @default(uuid(7)) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       NotificationType
  title      String
  message    String
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id") @db.Uuid
  isRead     Boolean          @default(false) @map("is_read")
  readAt     DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation("notification_user", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

model NotificationPreference {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  email     Boolean          @default(true)
  inApp     Boolean          @default(true) @map("in_app")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation("notification_preferences", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("notification_preferences")
}
