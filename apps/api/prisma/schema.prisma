// ─── Quotation (spec §13, §14, DESIGN Q5, Phase 2 Day 11) ──────────────────────

enum QuotationStatus {
  REQUESTED
  RECEIVED
  SELECTED
  REJECTED
  EXPIRED
  WITHDRAWN
  CANCELLED

  @@map("quotation_status")
}

enum QuotationVersionStatus {
  ACTIVE
  SUPERSEDED
  SELECTED
  REJECTED
  WITHDRAWN
  EXPIRED

  @@map("quotation_version_status")
}

model Quotation {
  id                 String          @id @default(uuid(7)) @db.Uuid
  jobId              String          @map("job_id") @db.Uuid
  insuranceCompanyId String          @map("insurance_company_id") @db.Uuid
  quotationNo        String          @unique @map("quotation_no")
  quotationDate      DateTime?       @map("quotation_date") @db.Date
  validUntil         DateTime?       @map("valid_until") @db.Date
  status             QuotationStatus @default(REQUESTED)
  grossPremium       Decimal         @default(0) @map("gross_premium") @db.Decimal(15, 2)
  discount           Decimal         @default(0) @db.Decimal(15, 2)
  netPremium         Decimal         @default(0) @map("net_premium") @db.Decimal(15, 2)
  tax                Decimal         @default(0) @db.Decimal(15, 2)
  stampDuty          Decimal         @default(0) @map("stamp_duty") @db.Decimal(15, 2)
  totalAmount        Decimal         @default(0) @map("total_amount") @db.Decimal(15, 2)
  remark             String?
  version            Int             @default(1)
  requestedById      String?         @map("requested_by_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz(3)

  job              Job                @relation("job_quotations", fields: [jobId], references: [id])
  insuranceCompany InsuranceCompany   @relation(fields: [insuranceCompanyId], references: [id])
  requestedBy      User?              @relation("quotation_requester", fields: [requestedById], references: [id], onDelete: SetNull)
  items            QuotationItem[]
  versions         QuotationVersion[]
  selectedByJob    Job?               @relation("job_selected_quotation")
  proposals        Proposal[]
  bindings         Binding[]
  policies         Policy[]

  @@index([jobId])
  @@index([status])
  @@map("quotations")
}

model QuotationVersion {
  id               String                 @id @default(uuid(7)) @db.Uuid
  quotationId      String                 @map("quotation_id") @db.Uuid
  version          Int                    @default(1)
  status           QuotationVersionStatus @default(ACTIVE)
  quotationDate    DateTime?              @map("quotation_date") @db.Date
  validUntil       DateTime?              @map("valid_until") @db.Date
  grossPremium     Decimal                @default(0) @map("gross_premium") @db.Decimal(15, 2)
  discount         Decimal                @default(0) @db.Decimal(15, 2)
  netPremium       Decimal                @default(0) @map("net_premium") @db.Decimal(15, 2)
  tax              Decimal                @default(0) @db.Decimal(15, 2)
  stampDuty        Decimal                @default(0) @map("stamp_duty") @db.Decimal(15, 2)
  totalAmount      Decimal                @default(0) @map("total_amount") @db.Decimal(15, 2)
  commissionRate   Decimal?               @map("commission_rate") @db.Decimal(10, 4)
  commissionAmount Decimal?               @map("commission_amount") @db.Decimal(15, 2)
  deductible       Decimal?               @db.Decimal(15, 2)
  exclusion        String?                @db.Text
  specialCondition String?                @map("special_condition") @db.Text
  insurerReference String?                @map("insurer_reference")
  underwriter      String?
  attachment       String?
  remark           String?                @db.Text
  createdById      String?                @map("created_by_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?              @map("deleted_at") @db.Timestamptz(3)

  quotation        Quotation              @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  createdBy        User?                  @relation("quotation_version_creator", fields: [createdById], references: [id], onDelete: SetNull)
  items            QuotationItem[]
  proposals        Proposal[]

  @@unique([quotationId, version])
  @@index([quotationId])
  @@index([status])
  @@index([validUntil])
  @@map("quotation_versions")
}

model QuotationItem {
  id                 String            @id @default(uuid(7)) @db.Uuid
  quotationId        String            @map("quotation_id") @db.Uuid
  quotationVersionId String?           @map("quotation_version_id") @db.Uuid
  coverageId         String?           @map("coverage_id") @db.Uuid
  coverageName       String            @map("coverage_name")
  sumInsured         Decimal           @map("sum_insured") @db.Decimal(15, 2)
  rate               Decimal?          @db.Decimal(10, 6)
  deductible         Decimal?          @db.Decimal(15, 2)
  premium            Decimal           @db.Decimal(15, 2)
  remark             String?
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  quotation        Quotation          @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationVersion QuotationVersion?  @relation(fields: [quotationVersionId], references: [id], onDelete: Cascade)
  coverage         InsuranceCoverage? @relation(fields: [coverageId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([quotationVersionId])
  @@map("quotation_items")
}

// ─── Proposal (spec §15, DESIGN §29.7) ───────────────────────────────────────

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED

  @@map("proposal_status")
}

enum ProposalRejectReason {
  PRICE
  COVERAGE
  COMPETITOR
  CUSTOMER_CANCELLED
  NO_RESPONSE
  OTHER

  @@map("proposal_reject_reason")
}

model Proposal {
  id                 String                @id @default(uuid(7)) @db.Uuid
  proposalNo         String                @unique @map("proposal_no")
  jobId              String                @map("job_id") @db.Uuid
  quotationId        String                @map("quotation_id") @db.Uuid
  quotationVersionId String?               @map("quotation_version_id") @db.Uuid
  paymentTermId      String?               @map("payment_term_id") @db.Uuid
  customerId         String                @map("customer_id") @db.Uuid
  proposalDate       DateTime?             @map("proposal_date") @db.Date
  validUntil         DateTime?             @map("valid_until") @db.Date
  status             ProposalStatus        @default(DRAFT)
  sentAt             DateTime?             @map("sent_at") @db.Timestamptz(3)
  acceptedAt         DateTime?             @map("accepted_at") @db.Timestamptz(3)
  rejectedAt         DateTime?             @map("rejected_at") @db.Timestamptz(3)
  rejectReason       ProposalRejectReason? @map("reject_reason")
  coverageSummary    String?               @map("coverage_summary") @db.Text
  terms              String?               @db.Text
  conditions         String?               @db.Text
  remark             String?
  version            Int                   @default(1)
  createdById        String?               @map("created_by_id") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  job              Job               @relation(fields: [jobId], references: [id])
  quotation        Quotation         @relation(fields: [quotationId], references: [id])
  quotationVersion QuotationVersion? @relation(fields: [quotationVersionId], references: [id], onDelete: SetNull)
  paymentTerm      PaymentTerm?      @relation(fields: [paymentTermId], references: [id], onDelete: SetNull)
  customer         Customer          @relation(fields: [customerId], references: [id])
  createdBy        User?             @relation("proposal_creator", fields: [createdById], references: [id], onDelete: SetNull)
  approvals        Approval[]
  acceptances      ProposalAcceptance[]

  @@index([jobId])
  @@index([status])
  @@index([paymentTermId])
  @@map("proposals")
}

// ─── Acceptance Evidence (Phase 2 Day 14) ───────────────────────────────────

enum AcceptanceMethod {
  EMAIL
  SIGNED_DOCUMENT
  LINE
  MANUAL

  @@map("acceptance_method")
}

model ProposalAcceptance {
  id              String           @id @default(uuid(7)) @db.Uuid
  proposalId      String           @map("proposal_id") @db.Uuid
  proposalVersion Int              @map("proposal_version")
  acceptedByName  String           @map("accepted_by_name")
  acceptedAt      DateTime         @default(now()) @map("accepted_at") @db.Timestamptz(3)
  method          AcceptanceMethod @map("method")
  ipAddress       String?          @map("ip_address")
  evidenceFileId  String?          @map("evidence_file_id") @db.Uuid
  remark          String?
  recordedById    String?          @map("recorded_by_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  proposal     Proposal  @relation(fields: [proposalId], references: [id])
  evidenceFile Document? @relation(fields: [evidenceFileId], references: [id], onDelete: SetNull)
  recordedBy   User?     @relation("proposal_acceptance_recorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([proposalId])
  @@index([evidenceFileId])
  @@index([recordedById])
  @@map("proposal_acceptances")
}

// ─── Approval (spec §16) ─────────────────────────────────────────────────────

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("approval_status")
}

model Approval {
  id            String             @id @default(uuid(7)) @db.Uuid
  jobId         String             @map("job_id") @db.Uuid
  proposalId    String             @map("proposal_id") @db.Uuid
  approvalType  ApprovalRoleTarget @map("approval_type")
  requestedById String?            @map("requested_by_id") @db.Uuid
  approverId    String?            @map("approver_id") @db.Uuid
  status        ApprovalStatus     @default(PENDING)
  requestedAt   DateTime           @default(now()) @map("requested_at") @db.Timestamptz(3)
  approvedAt    DateTime?          @map("approved_at") @db.Timestamptz(3)
  rejectedAt    DateTime?          @map("rejected_at") @db.Timestamptz(3)
  reason          String?
  rejectReason    String?            @map("reject_reason")
  comment         String?
  remark          String?
  resubmittedAt   DateTime?          @map("resubmitted_at") @db.Timestamptz(3)
  resubmittedById String?            @map("resubmitted_by_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  job           Job      @relation(fields: [jobId], references: [id])
  proposal      Proposal @relation(fields: [proposalId], references: [id])
  requestedBy   User?    @relation("approval_requester", fields: [requestedById], references: [id], onDelete: SetNull)
  approver      User?    @relation("approval_approver", fields: [approverId], references: [id], onDelete: SetNull)
  resubmittedBy User?    @relation("approval_resubmitter", fields: [resubmittedById], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([status])
  @@map("approvals")
}

// ─── Idempotency (DESIGN §5.1) ───────────────────────────────────────────────

model IdempotencyKey {
