  toUser    User? @relation("assignment_to_user", fields: [toUserId], references: [id], onDelete: SetNull)
  changedBy User? @relation("assignment_changed_by", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([role])
