NODE_ENV=development

# apps/api
API_PORT=3000
# 5433 (not the default 5432) to avoid clashing with other local Postgres containers on this machine
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/insurance?schema=public
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5433/insurance_test?schema=public

# apps/web (dev proxy allows this origin)
WEB_PORT=4200

# prisma/seed.ts — password for all sample users (dev only)
SEED_USER_PASSWORD=Password@123

# auth (DESIGN §8) — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7

# Redis (BullMQ queue for renewals/notifications)
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS: comma-separated allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost:4200

# Storage: 'local' writes to UPLOAD_DIR; 's3' uses MinIO-compatible endpoint
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
# S3/MinIO (only used when STORAGE_DRIVER=s3)
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=insurance-uploads
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1
